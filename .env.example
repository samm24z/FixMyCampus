# FixMyCampus AI - Global Environment Variables

# Project & Environment
PROJECT_NAME="FixMyCampus AI"
ENVIRONMENT="development"
DEBUG=True

# Backend Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_STR="/api/v1"

# Self-signup is limited to these email domains (comma separated, exact match; empty = no limit).
ALLOWED_EMAIL_DOMAINS="mvsrec.edu.in"

# Supabase Auth (sign-up, login, password reset). The backend verifies tokens with the project's
# public keys; the service-role/secret key is server-only and lets the Admin page create/deactivate accounts.
# The backend refuses to start with ENVIRONMENT="production" and no SUPABASE_URL.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Database Configuration (PostgreSQL + pgvector)
# Local Docker uses the values below. For a hosted database (Supabase) paste its connection
# strings as-is - "postgresql://...pooler.supabase.com:6543/postgres" is accepted - and see
# docs/DEPLOYMENT.md. DATABASE_URL = transaction pooler (port 6543);
# MIGRATION_DATABASE_URL = session pooler (port 5432), used by Alembic only.
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/fixmycampus_db"
# MIGRATION_DATABASE_URL=""
# TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/fixmycampus_test"
DB_ECHO=False

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Frontend Configuration (put these in frontend/.env; the anon key is public by design)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY=""
VITE_ALLOWED_EMAIL_DOMAIN="mvsrec.edu.in"

# AI / ML Configuration
AI_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
AI_CLASSIFIER_MODEL="distilbert-base-uncased"
AI_SIMILARITY_THRESHOLD=0.82
OPENAI_API_KEY="your_openai_api_key_here_for_rag_optional"
