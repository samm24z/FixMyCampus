# FixMyCampus AI - Global Environment Variables

# Project & Environment
PROJECT_NAME="FixMyCampus AI"
ENVIRONMENT="development"
DEBUG=True

# Backend Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_STR="/api/v1"
SECRET_KEY="development_super_secret_key_change_in_production_jwt_random_string"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="fixmycampus_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/fixmycampus_db"

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# AI / ML Configuration
AI_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
AI_CLASSIFIER_MODEL="distilbert-base-uncased"
AI_SIMILARITY_THRESHOLD=0.82
OPENAI_API_KEY="your_openai_api_key_here_for_rag_optional"
